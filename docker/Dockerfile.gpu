# GPU image (CUDA + ONNX Runtime GPU). For TensorRT, use the onnxruntime TensorRT EP or an NGC TensorRT base image.
# Run with: docker run --gpus all ...
FROM nvidia/cuda:12.2.2-cudnn8-runtime-ubuntu22.04
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip libglib2.0-0 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
# onnxruntime-gpu is installed via the [gpu] extra
RUN pip3 install --no-cache-dir ".[gpu]"
COPY configs ./configs
COPY scripts ./scripts
ENTRYPOINT ["python3", "-m", "visionpipe"]
CMD ["--help"]
